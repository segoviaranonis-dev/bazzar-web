# Copiar como .env.local — NUNCA subir al repo

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://TU_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sitio público (return_url / cancel_url Bancard)
NEXT_PUBLIC_SITE_URL=https://www.bazzar.com.py

# Admin
ADMIN_EMAIL=admin@bazzar.com.py
BAZZAR_ADMIN_EMAILS=admin@bazzar.com.py
ADMIN_WHATSAPP=595981000000

# Scripts locales + /auditoria-local (SOLO :3002 · no deploy prod)
DATABASE_URL=postgresql://postgres.TU_REF:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# NEXT_PUBLIC_AUDITORIA_LOCAL=1  # fuerza nav Auditoría · =0 la oculta

# Delivery Bazzar (EDB) — sync post-pago
DELIVERY_BAZZAR_URL=http://localhost:3005
# NEXT_PUBLIC_DELIVERY_BAZZAR_URL=http://localhost:3005

# Bancard VPOS Single Buy (credenciales Laura / portal)
# Sin estas tres → init SIMULA pago (solo desarrollo / pre-keys)
BANCARD_PUBLIC_KEY=
BANCARD_PRIVATE_KEY=
BANCARD_COMMERCE_CODE=
# sandbox | production
BANCARD_ENV=sandbox
# Opcional: override base VPOS
# BANCARD_VPOS_BASE=https://vpos.infonet.com.py:8888
#
# En portal Bancard registrar URL de confirmación:
#   https://www.bazzar.com.py/api/payments/bancard/callback
# (sandbox: la misma app + tunnel/ngrok si hace falta)
